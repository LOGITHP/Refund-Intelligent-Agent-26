# Backend Server Settings
PROJECT_NAME="Shipkart E-Commerce API"
API_V1_STR="/api/v1"

# Database (PostgreSQL recommended for production/Docker; SQLite supported for isolated local dev/tests)
# DATABASE_URL="postgresql+psycopg://shipkart:shipkart_dev_pass@localhost:5432/shipkart"
DATABASE_URL="sqlite:///./data/ecommerce.db"

# Security / JWT Authentication & AES-256-GCM Field Encryption
SECRET_KEY="shipkart-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_DATA_ENCRYPTION_KEY=""

# PayPal Sandbox REST API Configuration
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="SANDBOX"
RESERVATION_TTL_MINUTES=15

# Refund Intelligence Platform Authenticated Bridge
AGENT_PLATFORM_URL="http://localhost:8100"
AGENT_PLATFORM_DOCKER_URL="http://host.docker.internal:8100"
BRIDGE_SHARED_SECRET="shipkart-agent-bridge-hmac-dev-only-change-in-prod"
SERVICE_JWT_SECRET="shipkart-agent-service-jwt-dev-only-change-in-prod"
SERVICE_JWT_ISSUER="refund-intelligence-platform"

# MinIO Object Storage
MINIO_ENDPOINT="minio:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=false

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002"
