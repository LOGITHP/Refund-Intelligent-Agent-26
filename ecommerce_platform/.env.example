# PostgreSQL Primary Database (used by Docker Compose)
POSTGRES_DB=shipkart
POSTGRES_USER=shipkart
POSTGRES_PASSWORD=shipkart_dev_pass
DATABASE_URL=postgresql+psycopg://shipkart:shipkart_dev_pass@localhost:5432/shipkart

# Security / JWT & Field Encryption
SECRET_KEY=shipkart-dev-secret-key-change-in-production
APP_DATA_ENCRYPTION_KEY=

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# PayPal Sandbox REST App Credentials (never commit real secrets)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=SANDBOX
RESERVATION_TTL_MINUTES=15

# Refund Intelligence Platform Authenticated Bridge
AGENT_PLATFORM_URL=http://localhost:8100
AGENT_PLATFORM_DOCKER_URL=http://host.docker.internal:8100
VITE_API_URL=http://localhost:8000
VITE_AGENT_API_URL=http://localhost:8100
VITE_OPS_CONSOLE_URL=http://localhost:3002
BRIDGE_SHARED_SECRET=shipkart-agent-bridge-hmac-dev-only-change-in-prod
SERVICE_JWT_SECRET=shipkart-agent-service-jwt-dev-only-change-in-prod
SERVICE_JWT_ISSUER=refund-intelligence-platform
