# ==============================================================================
# Refund Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in `refund_intelligence_platform/` before running
# Docker Compose or local services. Never commit real secrets to Git.

# --- PostgreSQL 16 (Agent Platform DB on host port 5433) ---
POSTGRES_DB=refund_intelligence
POSTGRES_USER=refund_agent
POSTGRES_PASSWORD=refund_agent_dev_pass
DATABASE_URL=postgresql+psycopg://refund_agent:refund_agent_dev_pass@localhost:5433/refund_intelligence

# --- Redis 7 & Celery (host port 6379) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Agent MinIO Object Storage (API port 9002, Console port 9003) ---
MINIO_ENDPOINT=localhost:9002
MINIO_PUBLIC_URL=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
BUCKET_EVIDENCE=refund-evidence
BUCKET_REPORTS=refund-reports

# --- Shipkart (ecommerce_platform) Authenticated Bridge ---
# Local non-Docker backend: http://localhost:8000
# Docker Compose agent_backend/workers: http://host.docker.internal:8000
SHIPKART_API_URL=http://localhost:8000
# Must match ecommerce_platform BRIDGE_SHARED_SECRET for HMAC-SHA256 webhooks
BRIDGE_SHARED_SECRET=
# Shared secret for signing/verifying short-lived Service JWTs between Shipkart <-> Agent Core
SERVICE_JWT_SECRET=
# Must match ecommerce_platform SECRET_KEY to verify Customer/Merchant JWTs cleanly
JWT_SECRET_KEY=

# --- Platform Operations Service Login (email + password -> JWT) ---
# Optional bootstrap operator account created on startup if set (leave blank to use first-run setup UI)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_JWT_EXPIRE_MINUTES=720

# --- NVIDIA NIM Free Tier LLM Configuration ---
# Generate a free key (nvapi-...) at https://build.nvidia.com/
# Leave blank to run in deterministic offline fallback mode (no external LLM calls)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- PayPal Sandbox / Live REST Credentials ---
# Use Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Simulated Downstream Pipelines ---
# Local ports: 8201 (Issuer), 8202 (Regulatory), 8203 (Carrier)
# Inside Docker Compose, agent_backend overrides these with service DNS names.
ISSUER_SIMULATOR_URL=http://localhost:8201
REGULATORY_SIMULATOR_URL=http://localhost:8202
CARRIER_SIMULATOR_URL=http://localhost:8203

# --- Service Ports & Frontend API Base ---
AGENT_API_PORT=8100
OPS_FRONTEND_PORT=3002
VITE_AGENT_API_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
