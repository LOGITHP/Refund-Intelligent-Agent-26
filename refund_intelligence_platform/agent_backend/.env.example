# ==============================================================================
# Agent Backend Local Non-Docker Development Template
# ==============================================================================
# Copy to `agent_backend/.env` when running `uvicorn app.main:app --port 8100`
# directly on your host machine against local/forwarded Postgres, Redis, MinIO,
# and simulators.

ENVIRONMENT=development
AGENT_API_PORT=8100

# Local Postgres 16 container/instance on port 5433
DATABASE_URL=postgresql+psycopg://refund_agent:refund_agent_dev_pass@localhost:5433/refund_intelligence

# Local Redis 7 on port 6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Local Agent MinIO on port 9002
MINIO_ENDPOINT=localhost:9002
MINIO_PUBLIC_URL=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
BUCKET_EVIDENCE=refund-evidence
BUCKET_REPORTS=refund-reports

# Shipkart Bridge (running on localhost:8000)
SHIPKART_API_URL=http://localhost:8000
BRIDGE_SHARED_SECRET=
SERVICE_JWT_SECRET=
JWT_SECRET_KEY=

# NVIDIA NIM Free Tier (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# PayPal Sandbox
PAYPAL_ENV=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Simulators (local ports)
ISSUER_SIMULATOR_URL=http://localhost:8201
REGULATORY_SIMULATOR_URL=http://localhost:8202
CARRIER_SIMULATOR_URL=http://localhost:8203

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
